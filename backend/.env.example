# Rolio Backend Configuration
# Copy this file to .env and fill in values. NEVER commit the real .env.
#
#   cp .env.example .env
#
# In development, empty secrets are auto-generated at startup (sessions and
# encrypted Gmail tokens will NOT survive a restart until you set real values).
# In production (ROLIO_ENV=production), the app refuses to start if required
# secrets are missing or invalid.

# ─── Environment ─────────────────────────────────────────────
# "development" or "production"
ROLIO_ENV=development

# ─── Security ────────────────────────────────────────────────
# JWT signing secret. Generate: openssl rand -base64 48
ROLIO_SECRET_KEY=
# CSRF double-submit secret. Generate: openssl rand -base64 32
CSRF_SECRET=
# Fernet key for encrypting Gmail OAuth tokens at rest. REQUIRED for Gmail.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If empty in development, an ephemeral key is used — Gmail tokens will NOT
# survive a backend restart (users must reconnect Gmail).
TOKEN_ENCRYPTION_KEY=

# ─── Database ────────────────────────────────────────────────
# SQLite works out of the box for local development.
DATABASE_URL=sqlite:///./rolio.db
# For PostgreSQL/Supabase, use the SQLAlchemy driver form:
# postgresql://user:password@host:5432/postgres

# ─── Frontend / CORS ─────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_ORIGINS=http://localhost:3000
BACKEND_PUBLIC_ORIGIN=http://localhost:8001
APP_PUBLIC_URL=http://localhost:3000

# ─── HTTPS enforcement ───────────────────────────────────────
# Defaults to true when ROLIO_ENV=production. Plain-HTTP requests are
# 308-redirected to https:// (health check exempt). Requires a TLS-terminating
# reverse proxy (nginx/Caddy/cloud LB) in front of the app.
# FORCE_HTTPS=true
# Proxy IPs/networks allowed to set X-Forwarded-* headers. "*" trusts all hops
# (only safe when the app is unreachable except through the proxy). Without
# this, client-IP based rate limiting falls back to proxy IPs.
# TRUSTED_PROXIES=*

# ─── Token Lifetimes ─────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google OAuth (Gmail sync + Sign in with Google) — OPTIONAL ── ────────────────────
# Create credentials at https://console.cloud.google.com (OAuth client, Web app).
# Add BOTH redirect URIs:
#   http://localhost:8001/api/gmail/callback        (Gmail sync)
#   http://localhost:8001/api/auth/google/callback  (Sign in with Google)
# Without these, everything works except Gmail sync and Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/gmail/callback

# ─── AI Services — OPTIONAL (NVIDIA Nemotron via OpenAI-compatible API) ──
# Without a key, AI features return graceful fallback responses.
NEMOTRON_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_NANO_MODEL=nvidia/nemotron-3-nano-30b-a3b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── Job Search (RapidAPI JSearch) — OPTIONAL ────────────────
# Without a key, local seeded jobs are searched; external live search is
# reported as "unavailable" instead of failing.
JSEARCH_API_KEY=

# ─── Uploads ─────────────────────────────────────────────────
# UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_AI_PER_MINUTE=20
RATE_LIMIT_JSEARCH_PER_MINUTE=30
RATE_LIMIT_UPLOAD_PER_HOUR=10
