# Rolio Docker Environment Variables
# Copy this file to .env and fill in your values

# Database
POSTGRES_PASSWORD=your_secure_password_here

# Application Security
ROLIO_SECRET_KEY=your_random_secret_key_here
CSRF_SECRET=your_csrf_secret_here
TOKEN_ENCRYPTION_KEY=your_fernet_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8001/api/gmail/callback

# AI Services
NEMOTRON_API_KEY=your_nemotron_key

# Job Search
JSEARCH_API_KEY=your_jsearch_key

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001
